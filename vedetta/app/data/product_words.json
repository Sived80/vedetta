{
 "_comment": "Product words found in a device name -> the label that stays readable in the export (the rest of the name is masked). The first row that matches wins. Each row: label, regular expression (case-insensitive). A lost table only makes the labels less readable (Device-1): the names are masked all the same.",
 "products": [
  ["iPhone", "iphone"],
  ["iPad", "ipad"],
  ["MacBook", "macbook"],
  ["iMac", "imac"],
  ["AppleWatch", "apple[\\W_]*watch"],
  ["AppleTV", "apple[\\W_]*tv"],
  ["HomePod", "homepod"],
  ["Mac", "(?<!\\w)mac(?!\\w)"],
  ["Chromecast", "chromecast"],
  ["Echo", "(?<!\\w)echo"],
  ["Alexa", "alexa"],
  ["Nest", "(?<!\\w)nest"],
  ["PlayStation", "playstation|(?<!\\w)ps[2345](?!\\w)"],
  ["Xbox", "xbox"],
  ["Switch", "nintendo"],
  ["Shelly", "shelly"],
  ["Tasmota", "tasmota"],
  ["ESP", "(?<!\\w)esp[\\W_]*\\d*[\\W_]?[0-9a-f]*"],
  ["Galaxy", "galaxy"],
  ["Pixel", "pixel"],
  ["Android", "android"],
  ["Phone", "phone|cellulare|telefono"],
  ["TV", "(?<!\\w)tv(?!\\w)|television|televisore"],
  ["Printer", "printer|stampante"],
  ["Camera", "camera|(?<!\\w)cam(?!\\w)"],
  ["Router", "router|gateway|fritz"],
  ["NAS", "(?<!\\w)nas(?!\\w)"],
  ["PC", "(?<!\\w)pc(?!\\w)|desktop|laptop|notebook"],
  ["Raspberry", "raspberry|(?<!\\w)rpi"]
 ]
}
